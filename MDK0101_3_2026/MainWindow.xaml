<Window x:Class="MDK0101_3_2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MDK0101_3_2026"
        mc:Ignorable="d"
        Title="Delegates" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <TabControl Margin="10">
        <TabItem Header="1" MinWidth="100">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button x:Name="OpenChildButton"
                        Grid.Row="0"
                        Content="Открыть дочернее окно"
                        Padding="12,6"
                        HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="1"
                           Margin="0,16,0,4"
                           Text="Результат из дочернего окна:"/>

                <Border Grid.Row="2"
                        BorderBrush="Gray" BorderThickness="1"
                        Padding="8" Margin="0,4,0,0">
                    <TextBlock x:Name="ResultTextBlock"
                               FontSize="16"
                               TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="2" MinWidth="100">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button x:Name="StartTaskButton"
                            Content="Запустить"
                            Padding="12,6" Margin="0,0,8,0"/>
                    <Button x:Name="CancelTaskButton"
                            Content="Отменить"
                            Padding="12,6"
                            IsEnabled="False"/>
                </StackPanel>

                <ProgressBar x:Name="TaskProgressBar"
                             Grid.Row="1"
                             Height="24" Margin="0,16,0,0"
                             Minimum="0" Maximum="100"/>

                <TextBlock x:Name="TaskStatusText"
                           Grid.Row="2"
                           Margin="0,8,0,0"
                           Text="Готов к запуску"/>
            </Grid>
        </TabItem>

        <TabItem Header="3" MinWidth="100">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Исходный текст:"/>
                <TextBox x:Name="StrategyInputTextBox"
                         Grid.Row="1"
                         Margin="0,4,0,0"
                         Height="32"
                         VerticalContentAlignment="Center"/>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Margin="0,12,0,0">
                    <ComboBox x:Name="StrategyComboBox"
                              Width="200"
                              SelectedIndex="0">
                        <ComboBoxItem>Верхний регистр</ComboBoxItem>
                        <ComboBoxItem>Реверс</ComboBoxItem>
                        <ComboBoxItem>Без изменений</ComboBoxItem>
                    </ComboBox>
                    <Button x:Name="ApplyStrategyButton"
                            Content="Применить"
                            Click="ApplyStrategyButton_Click"
                            Padding="12,6" Margin="8,0,0,0"/>
                </StackPanel>

                <Border Grid.Row="3"
                        BorderBrush="Gray" BorderThickness="1"
                        Padding="8" Margin="0,16,0,0">
                    <TextBlock x:Name="StrategyOutputTextBlock"
                               FontSize="16"
                               TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="4" MinWidth="100">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button x:Name="IncrementButton"
                        Grid.Row="0"
                        Content="Увеличить счётчик"
                        Padding="12,6"
                        HorizontalAlignment="Left"/>

                <GroupBox Grid.Row="1" Header="Подписчик 1 — лог" Margin="0,16,0,0">
                    <TextBox x:Name="LogTextBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="Подписчик 2 — список" Margin="0,16,0,0">
                    <ListBox x:Name="ValuesListBox"/>
                </GroupBox>
            </Grid>
        </TabItem>

        <TabItem Header="5" MinWidth="100">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBox x:Name="ValidationInputTextBox"
                             Width="300" Height="32"
                             VerticalContentAlignment="Center"/>
                    <Button x:Name="AddValidatedButton"
                            Content="Добавить"
                            Padding="12,6" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="ValidationErrorTextBlock"
                           Grid.Row="1"
                           Margin="0,8,0,0"
                           Foreground="Firebrick"
                           TextWrapping="Wrap"/>

                <ListBox x:Name="ValidatedItemsListBox"
                         Grid.Row="3"
                         Margin="0,16,0,0"/>
            </Grid>
        </TabItem>

    </TabControl>
</Window>
