<Window x:Class="RoutedEvents.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoutedEvents"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ -->
        <StackPanel Grid.Column="0">

            <TextBlock Text="1. Tunnel → Bubble"
                       FontWeight="Bold" FontSize="15" Margin="0,0,0,5"/>

            <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10">
                Кликни кнопку. Смотри лог: сначала Preview (tunnel, сверху вниз),
                потом обычное (bubble, снизу вверх).
                Зажми Shift — PreviewMouseDown погасит событие, MouseDown не наступит.
            </TextBlock>

            <!-- Вложенность: Border → StackPanel → Button -->
            <Border BorderBrush="Gray" BorderThickness="2" Padding="15"
                    PreviewMouseDown="Border_PreviewMouseDown"
                    MouseDown="Border_MouseDown">

                <StackPanel PreviewMouseDown="Panel_PreviewMouseDown"
                            MouseDown="Panel_MouseDown">

                    <TextBlock Text="Вложенный StackPanel" FontWeight="SemiBold"/>

                    <Button Content="Кликни меня"
                            Margin="0,10,0,0" Padding="15"
                            PreviewMouseDown="Button_PreviewMouseDown"
                            MouseDown="Button_MouseDown"
                            Click="Button_Click"/>
                </StackPanel>
            </Border>

            <Separator Margin="0,20"/>

            <TextBlock Text="2. Один обработчик на контейнер"
                       FontWeight="Bold" FontSize="15" Margin="0,0,0,5"/>

            <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10">
                Три кнопки, один обработчик на StackPanel.Button.Click.
                sender — StackPanel, OriginalSource — конкретная кнопка.
            </TextBlock>

            <StackPanel Button.Click="Container_Click" Orientation="Horizontal">
                <Button Content="A" Width="50" Margin="0,0,5,0" Tag="A"/>
                <Button Content="B" Width="50" Margin="0,0,5,0" Tag="B"/>
                <Button Content="C" Width="50" Tag="C"/>
            </StackPanel>

            <Button Content="Очистить лог" Margin="0,20,0,0"
                    HorizontalAlignment="Left" Padding="10,5"
                    Click="Clear_Click"/>
        </StackPanel>

        <!-- ПРАВАЯ ПАНЕЛЬ: лог -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Журнал событий"
                       FontWeight="Bold" FontSize="15" Margin="0,0,0,5"/>

            <ListBox x:Name="LogListBox" Grid.Row="1"
                     FontFamily="Consolas" FontSize="11"/>
        </Grid>
    </Grid>
</Window>
